# Base URLs for testing
BASE_URL=http://localhost:3000
API_BASE_URL=https://api.example.com

# Test Environment
TEST_ENV=dev
START_LOCAL_SERVER=false

# Browser Configuration
HEADLESS=true
BROWSER=chromium
TIMEOUT=30000

# Reporting
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report

# Test account used by every test that requires authentication
# (values go in .env, never here)
TEST_USER_NAME=
TEST_USER_PASSWORD=
